diff --git a/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdateCoalescer.java b/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdateCoalescer.java
new file mode 100644
index 0000000000000000000000000000000000000000..902e93219112d1d1938d1e1463315f8deb8165af
--- /dev/null
+++ b/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdateCoalescer.java
@@ -0,0 +1,91 @@
+package puregero.multipaper.externalserverprotocol;
+
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientboundMoveEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundRotateHeadPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket;
+import net.minecraft.network.protocol.game.ClientboundTeleportEntityPacket;
+import puregero.multipaper.ExternalServerConnection;
+import puregero.multipaper.MultiPaper;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Drops superseded position/motion packets before they hit the main thread.
+ *
+ * Under clustered-player load each receiving server can pull thousands of
+ * EntityUpdatePackets per second, every one of which used to schedule its own
+ * task on the Minecraft main thread. The queue would grow faster than it
+ * drained, and mirrored players appeared to freeze because their *latest*
+ * position update was stuck behind hundreds of stale ones.
+ *
+ * Position-style packets are last-write-wins by design — vanilla MC clients
+ * already cope with packet loss in this category. We collapse multiple updates
+ * for the same {@code (entity, packetClass)} into the most recent one and
+ * apply it from a single per-tick drain task.
+ */
+public final class EntityUpdateCoalescer {
+
+    private EntityUpdateCoalescer() {}
+
+    /**
+     * Most-recent pending update per (entityUuid, packetClass). Concurrent because
+     * Netty receive threads put while the main thread drains.
+     */
+    private static final Map<Key, Pending> pending = new ConcurrentHashMap<>();
+
+    /** True while a drain task has been scheduled and not yet started. */
+    private static final AtomicBoolean drainScheduled = new AtomicBoolean(false);
+
+    /**
+     * Position / rotation / velocity / teleport packets are safe to coalesce —
+     * each one carries the entity's *current* state in the relevant axis, so
+     * an older one is fully overridden by a newer one. Metadata, equipment,
+     * animations etc. carry deltas and must not be coalesced.
+     */
+    public static boolean isCoalescable(Packet<?> packet) {
+        return packet instanceof ClientboundMoveEntityPacket
+                || packet instanceof ClientboundTeleportEntityPacket
+                || packet instanceof ClientboundSetEntityMotionPacket
+                || packet instanceof ClientboundRotateHeadPacket;
+    }
+
+    public static void enqueue(ExternalServerConnection connection,
+                               UUID world,
+                               UUID entityUuid,
+                               long chunkPos,
+                               Packet<?> packet) {
+        pending.put(new Key(entityUuid, packet.getClass()),
+                new Pending(connection, world, entityUuid, chunkPos, packet));
+        if (drainScheduled.compareAndSet(false, true)) {
+            MultiPaper.runSync(EntityUpdateCoalescer::drain);
+        }
+    }
+
+    private static void drain() {
+        // Release the slot before iterating: any put that races us after this
+        // line will schedule a fresh drain, ensuring no updates get stranded.
+        drainScheduled.set(false);
+
+        // Weakly-consistent iteration over the live map. The CAS-remove makes
+        // sure we don't apply a stale Pending that has since been replaced by
+        // a newer one (the newer one will be drained on the next tick).
+        pending.forEach((key, value) -> {
+            if (pending.remove(key, value)) {
+                EntityUpdatePacket.applyOnMain(value.connection, value.world,
+                        value.entityUuid, value.chunkPos, value.packet, 0);
+            }
+        });
+    }
+
+    private record Key(UUID entityUuid, Class<? extends Packet> packetClass) {}
+
+    private record Pending(ExternalServerConnection connection,
+                           UUID world,
+                           UUID entityUuid,
+                           long chunkPos,
+                           Packet<?> packet) {}
+}
diff --git a/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdatePacket.java b/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdatePacket.java
index 4e7d66ad3a0eb32e0bdc1c14d659fc9fafc00609..44759671dc47d73676ea8a4a999c88aaced94cf1 100644
--- a/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdatePacket.java
+++ b/src/main/java/puregero/multipaper/externalserverprotocol/EntityUpdatePacket.java
@@ -37,11 +37,43 @@ public class EntityUpdatePacket extends ExternalServerPacket {
 
     private final long chunkPos;
 
+    /**
+     * Pre-serialized inner packet bytes: {@code varint(packetId) || packet.write(buf)}.
+     * Populated eagerly in the outbound constructor so that broadcasting the same
+     * EntityUpdatePacket to N peer servers no longer re-runs the (expensive)
+     * Minecraft packet serializer N times. Null for the inbound constructor —
+     * we keep the decoded {@link #packet} and never re-serialize it.
+     */
+    private final byte[] preEncodedInner;
+
     public EntityUpdatePacket(Entity entity, Packet<?> packet) {
         this.world = ((ServerLevel) entity.level()).uuid;
         this.uuid = entity.getUUID();
         this.packet = packet;
         this.chunkPos = entity.chunkPosition().longKey;
+        this.preEncodedInner = serializeInner(packet);
+    }
+
+    private static byte[] serializeInner(Packet<?> packet) {
+        ConnectionProtocol protocol = ConnectionProtocol.getProtocolForPacket(packet);
+        Integer id = protocol.getPacketId(PacketFlow.CLIENTBOUND, packet);
+        ByteBuf buf = Unpooled.buffer();
+        try {
+            FriendlyByteBuf friendlyByteBuf = new FriendlyByteBuf(buf);
+            friendlyByteBuf.writeVarInt(id);
+            // Inhibit recursive update-generation that LivingEntity gates on.
+            threadsWritingUpdatePackets.add(Thread.currentThread().getId());
+            try {
+                packet.write(friendlyByteBuf);
+            } finally {
+                threadsWritingUpdatePackets.remove(Thread.currentThread().getId());
+            }
+            byte[] bytes = new byte[buf.readableBytes()];
+            buf.readBytes(bytes);
+            return bytes;
+        } finally {
+            buf.release();
+        }
     }
 
     public EntityUpdatePacket(FriendlyByteBuf in) {
@@ -53,64 +85,72 @@ public class EntityUpdatePacket extends ExternalServerPacket {
         int packetId = friendlyByteBuf.readVarInt();
         packet = ConnectionProtocol.PLAY.createPacket(PacketFlow.CLIENTBOUND, packetId, friendlyByteBuf);
         this.chunkPos = in.readLong();
+        this.preEncodedInner = null;
     }
 
     @Override
     public void write(FriendlyByteBuf out) {
         out.writeUUID(world);
         out.writeUUID(uuid);
-
-        ConnectionProtocol protocol = ConnectionProtocol.getProtocolForPacket(packet);
-        Integer id = protocol.getPacketId(PacketFlow.CLIENTBOUND, packet);
-        ByteBuf buf = Unpooled.buffer();
-        FriendlyByteBuf friendlyByteBuf = new FriendlyByteBuf(buf);
-        friendlyByteBuf.writeVarInt(id);
-        threadsWritingUpdatePackets.add(Thread.currentThread().getId());
-        packet.write(friendlyByteBuf);
-        threadsWritingUpdatePackets.remove(Thread.currentThread().getId());
-        out.writeByteArray(buf.array());
+        // preEncodedInner is populated by the outbound constructor. For the
+        // inbound path (if a received packet is somehow re-forwarded) we fall
+        // back to serializing the wrapped Minecraft packet on demand.
+        out.writeByteArray(preEncodedInner != null ? preEncodedInner : serializeInner(packet));
         out.writeLong(this.chunkPos);
     }
 
     @Override
     public void handle(ExternalServerConnection connection) {
-        MultiPaper.runSync(() -> handleLater(connection, 0));
+        if (EntityUpdateCoalescer.isCoalescable(packet)) {
+            // Position / rotation / motion / teleport: drop superseded updates
+            // for the same entity to keep the main-thread queue small under
+            // clustered-player load.
+            EntityUpdateCoalescer.enqueue(connection, world, uuid, chunkPos, packet);
+            return;
+        }
+        MultiPaper.runSync(() -> applyOnMain(connection, world, uuid, chunkPos, packet, 0));
     }
 
-    private void handleLater(ExternalServerConnection connection, int depth) {
+    /**
+     * Apply an entity update on the main thread. Must be called from the main
